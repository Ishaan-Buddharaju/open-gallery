[Unit]
Description=Gallery kiosk (Chromium)
After=open-gallery.service systemd-user-sessions.service
Wants=open-gallery.service

[Service]
Type=simple
User=ibuddhar
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
WorkingDirectory=/home/ibuddhar/open-gallery
ExecStart=/usr/bin/xinit /home/ibuddhar/open-gallery/deploy/kiosk.sh -- :0 vt1 -nocursor -keeptty
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
